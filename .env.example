# Copy to .env at the repo root (loaded by apps/server via --env-file-if-exists)

# OpenRouter API key — required for the agent loop (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Bunny API key — optional; falls back to the bunny CLI's profile (~/.config/bunnynet.json)
BUNNY_API_KEY=

# API server port (the web dev server proxies /api here)
# AGENT_PORT=8787
